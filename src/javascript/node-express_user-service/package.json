  "private": true,
  "description": "User management CRUD API (Express + DI + SOLID + mocks)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint . --ext .js",
