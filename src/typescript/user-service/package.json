{
  "name": "syncCoreAI-user-service",
  "version": "1.0.0",
  "description": "User Service for syncCoreAI (NestJS, TypeScript, Mock DB)",
  "main": "dist/main.js",
  "scripts": {
    "start": "nest start",
    "start:dev": "dotenv -e .env.real -- nest start --watch",
    "start:dev-mock": "dotenv -e .env.mock -- nest start --watch",
    "start:dev-db": "dotenv -e .env.db -- nest start --watch",
    "start:dev-redis-db": "dotenv -e .env.redis-db -- nest start --watch",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:smoke": "jest --config jest.smoke.config.js",
    "test:smoke:user": "jest --testPathPattern=smoke.test.ts",
    "test:smoke:role": "jest --testPathPattern=role-smoke.test.ts",
    "test:smoke:device": "jest --testPathPattern=device-smoke.test.ts",
    "prisma:init": "prisma init",
    "prisma:generate": "prisma generate",
    "prisma:generate:mock": "dotenv -e .env.mock -- prisma generate",
    "prisma:generate:db": "dotenv -e .env.db -- prisma generate",
    "prisma:generate:real": "dotenv -e .env.real -- prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "prisma:migrate:db": "dotenv -e .env.db -- prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "prisma:studio:db": "dotenv -e .env.db -- prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/config": "^2.3.0",
    "@prisma/client": "^5.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "dotenv-cli": "^7.0.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^5.0.3",
    "prisma": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "jest": "^29.5.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
