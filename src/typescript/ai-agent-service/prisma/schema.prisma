// Prisma schema for AI Agent Service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AgentTask {
  id          String   @id @default(uuid())
  userId      String
  role        String
  taskType    String
  documentId  String
  lang        String
  params      Json
  status      String   @default("pending")
  result      String?
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentLog {
  id        String   @id @default(uuid())
  taskId    String
  action    String
  status    String
  message   String?
  createdAt DateTime @default(now())
}
