{
  "name": "synccoreai-web-app",
  "version": "0.1.0",
  "private": true,
  "description": "SyncCoreAI Web Application - Collaborative document editing with AI assistance",
  "keywords": [
    "nextjs",
    "typescript",
    "tailwind",
    "redux",
    "websocket",
    "crdt",
    "ai"
  ],
  "author": "SyncCoreAI Team",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env MODE=development next dev",
    "dev:mock-api": "concurrently \"npm run mock-server\" \"npm run ws-server\" \"cross-env MODE=mock-api next dev\"",
    "dev:mock-data": "cross-env MODE=mock-data next dev",
    "dev:full": "npm run seed-data && concurrently \"npm run mock-server\" \"npm run ws-server\" \"cross-env MODE=mock-api next dev\"",
    "dev:reset": "npm run seed-data -- --reset && concurrently \"npm run mock-server\" \"npm run ws-server\" \"cross-env MODE=mock-api next dev\"",
    "dev:minimal": "npm run seed-data -- --minimal && concurrently \"npm run mock-server:quiet\" \"npm run ws-server:quiet\" \"cross-env MODE=mock-api next dev\"",
    "mock-server": "json-server --watch src/mocks/db.json --routes src/mocks/servers/routes.json --middlewares src/mocks/servers/middleware.js --port 3100",
    "mock-server:quiet": "json-server --watch src/mocks/db.json --routes src/mocks/servers/routes.json --middlewares src/mocks/servers/middleware.js --port 3100 --quiet",
    "mock-server:verbose": "json-server --watch src/mocks/db.json --routes src/mocks/servers/routes.json --middlewares src/mocks/servers/middleware.js --port 3100 --verbose",
    "ws-server": "node src/mocks/servers/websocket.js",
    "ws-server:quiet": "node src/mocks/servers/websocket.js > /dev/null 2>&1",
    "seed-data": "node scripts/seed-data.js",
    "seed-data:reset": "node scripts/seed-data.js --reset",
    "seed-data:minimal": "node scripts/seed-data.js --minimal",
    "build": "cross-env MODE=production next build",
    "build:static": "cross-env MODE=mock-data next build && next export",
    "build:analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "start:mock": "cross-env MODE=mock-api next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:mock": "cross-env MODE=mock-api jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "pre-commit": "npm run type-check && npm run lint:fix && npm run format && npm run test",
    "setup": "npm install && npm run seed-data",
    "setup:fresh": "npm install && npm run seed-data:reset",
    "debug": "cross-env NODE_OPTIONS='--inspect' next dev",
    "debug:mock": "concurrently \"npm run mock-server:verbose\" \"cross-env NODE_OPTIONS='--inspect' MODE=mock-api next dev\"",
    "clean": "rm -rf .next out dist node_modules/.cache",
    "clean:all": "rm -rf .next out dist node_modules node_modules/.cache && npm install",
    "health": "node scripts/health-check.js",
    "docs:generate": "node scripts/generate-docs.js"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.10.1",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "i18next": "^25.6.2",
    "json-server": "^0.17.4",
    "next": "^14.0.4",
    "next-i18next": "^15.4.2",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.3.3",
    "react-redux": "^9.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.4",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
