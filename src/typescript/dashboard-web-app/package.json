{
  "name": "synccoreai-dashboard-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "SyncCoreAI Dashboard Frontend - Vue 3 analytics dashboard with D3.js and Three.js",
  "keywords": [
    "vue3",
    "typescript",
    "vite",
    "d3js",
    "threejs",
    "tailwind",
    "pinia",
    "dashboard",
    "analytics"
  ],
  "author": "SyncCoreAI Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 3702",
    "dev:mock-api": "concurrently \"npm run mock-server\" \"vite --port 3702\"",
    "dev:mock-data": "cross-env VITE_MODE=mock-data vite --port 3702",
    "mock-server": "json-server --watch src/mocks/db.json --port 3800",
    "build": "vue-tsc && vite build",
    "build:analyze": "vue-tsc && vite build --analyze",
    "preview": "vite preview --port 3702",
    "type-check": "vue-tsc --noEmit",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lighthouse": "lighthouse http://localhost:3702 --output html --output-path ./lighthouse-report.html",
    "bundle-analyzer": "npx vite-bundle-analyzer"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.19",
    "@heroicons/vue": "^2.1.3",
    "@vueuse/core": "^10.9.0",
    "axios": "^1.6.8",
    "chart.js": "^4.4.2",
    "d3": "^7.9.0",
    "dayjs": "^1.11.10",
    "pinia": "^2.1.7",
    "three": "^0.162.0",
    "vue": "^3.4.21",
    "vue-chartjs": "^5.3.0",
    "vue-i18n": "12.0.0-alpha.3",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@mswjs/data": "^0.16.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.12",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.10.0",
    "@types/three": "^0.162.0",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.5",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.25.0",
    "jsdom": "^24.0.0",
    "json-server": "^1.0.0-alpha.23",
    "msw": "^2.2.13",
    "playwright": "^1.43.1",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.3",
    "vite": "^5.2.8",
    "vitest": "^1.4.0",
    "vue-tsc": "^2.0.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.6",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}